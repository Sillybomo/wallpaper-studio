<!-- @author bomo；用途：提供图片选择、预览和桌面显示方式选项。 -->
<Window x:Class="JBSWallpaperStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="壁纸工坊"
        Width="1120" Height="760" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="#F4F5F7"
        UseLayoutRounding="False" SnapsToDevicePixels="False"
        RenderOptions.EdgeMode="Unspecified"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="62" ResizeBorderThickness="8"
                            GlassFrameThickness="0" CornerRadius="18"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TrafficLight" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Light" Width="12" Height="12"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="#22000000" StrokeThickness="0.7" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Light" Property="Width" Value="13" />
                                <Setter TargetName="Light" Property="Height" Value="13" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#F4F5F7" />
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="BorderBrush" Value="#E7E8EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EAEBEF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="50" />
            <Setter Property="Background" Value="#1473E6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1473E6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#0F65CD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeOption" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="#F7F8FA"
                                BorderBrush="#EAEBEF" BorderThickness="1"
                                CornerRadius="13" Padding="13,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Grid x:Name="CheckMark" Grid.Column="1" Width="18" Height="18"
                                      Visibility="Collapsed">
                                    <Ellipse Fill="#1473E6" />
                                    <Path Data="M 4,9 L 7.5,12.5 L 14,5.5" Stroke="White"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#83B6F0" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#B7C8DD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="1" Background="#F4F5F7" BorderBrush="#E2E4E9"
            BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Button Style="{StaticResource TrafficLight}" Background="#FF5F57"
                            AutomationProperties.Name="关闭" Click="CloseButton_Click" Margin="0,0,7,0" />
                    <Button Style="{StaticResource TrafficLight}" Background="#FEBC2E"
                            AutomationProperties.Name="最小化" Click="MinimizeButton_Click" Margin="0,0,7,0" />
                    <Button Style="{StaticResource TrafficLight}" Background="#28C840"
                            AutomationProperties.Name="最大化或还原" Click="MaximizeButton_Click" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="10" Background="#E7F0FD"
                            Margin="0,0,10,0">
                        <Image Source="{StaticResource AppIconImage}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="3" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="壁纸工坊" Foreground="#1D1D1F"
                                   FontFamily="{StaticResource AppFont}" FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="挑选、预览，然后应用" Foreground="#8A8D94"
                                   FontFamily="{StaticResource AppFont}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Background="White" BorderBrush="#E9EAEF"
                        BorderThickness="1" CornerRadius="11" Padding="11,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#34C759" Margin="0,0,7,0" />
                        <TextBlock Text="仅在本机处理" Foreground="#6F737B"
                                   FontFamily="{StaticResource AppFont}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="22,8,22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.05*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#EAEBEF"
                        BorderThickness="1" CornerRadius="21" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="桌面预览" FontFamily="{StaticResource AppFont}"
                                           Foreground="#202124" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="查看图片在桌面上的呈现方式"
                                           FontFamily="{StaticResource AppFont}" Foreground="#8B8F97"
                                           FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F2F8F3" CornerRadius="10"
                                    Padding="10,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#34A853" Margin="0,0,6,0" />
                                    <TextBlock Text="原图直设" FontFamily="{StaticResource AppFont}"
                                               Foreground="#39854D" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="PreviewHost" Grid.Row="1" Background="#101116"
                                CornerRadius="16" ClipToBounds="True" Margin="0,18,0,14">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="UniformToFill"
                                       Visibility="Collapsed" SnapsToDevicePixels="True" />
                                <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="20"
                                            Background="#20232B" HorizontalAlignment="Center">
                                        <TextBlock Text="▧" FontSize="30" Foreground="#B7C3D6"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="从图库中挑一张" FontFamily="{StaticResource AppFont}"
                                               FontSize="16" FontWeight="SemiBold" Foreground="#F2F3F5"
                                               HorizontalAlignment="Center" Margin="0,18,0,0" />
                                    <TextBlock Text="选择图片或将文件拖到此处"
                                               FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="#A0A5AF" HorizontalAlignment="Center"
                                               Margin="0,7,0,0" />
                                    <Button Content="选择图片" Style="{StaticResource SecondaryButton}"
                                            Height="38" Padding="16,0" Margin="0,18,0,0"
                                            Click="SelectImageButton_Click" />
                                </StackPanel>
                                <Border VerticalAlignment="Bottom" Background="#B20C0D12"
                                        Padding="14,10" Visibility="{Binding ElementName=PreviewImage, Path=Visibility}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PreviewFileNameText" Foreground="White"
                                                   FontFamily="{StaticResource AppFont}" FontSize="12"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="PreviewDimensionsText" Grid.Column="1"
                                                   Foreground="#D1D3D8" FontFamily="{StaticResource AppFont}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="支持 JPG、PNG、BMP 与 TIFF 图片"
                                       Foreground="#8B8F97" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="更换图片"
                                    Style="{StaticResource SecondaryButton}" Height="36"
                                    Padding="13,0" Click="SelectImageButton_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="#EAEBEF"
                        BorderThickness="1" CornerRadius="21" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="设置壁纸" FontFamily="{StaticResource AppFont}"
                                       Foreground="#202124" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="选择一张图片，再设为桌面背景。"
                                       FontFamily="{StaticResource AppFont}" Foreground="#8B8F97"
                                       FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#F7F8FA" BorderBrush="#ECEEF2"
                                BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="11" Background="#E8F1FE">
                                    <TextBlock Text="▧" Foreground="#3478D4" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock x:Name="ImageNameText" Text="尚未选择图片"
                                               Foreground="#27292D" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ImageDetailsText" Text="JPG、PNG、BMP、TIFF"
                                               Foreground="#8B8F97" FontFamily="{StaticResource AppFont}"
                                               FontSize="10" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Grid.Row="2" Content="从电脑选择图片…"
                                Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                                Click="SelectImageButton_Click" />

                        <StackPanel Grid.Row="3" Margin="0,24,0,0">
                            <TextBlock Text="屏幕显示方式" FontFamily="{StaticResource AppFont}"
                                       Foreground="#3A3C41" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <RadioButton x:Name="FillModeButton" Style="{StaticResource ModeOption}"
                                         GroupName="WallpaperMode" Tag="10" IsChecked="True"
                                         Checked="PositionMode_Checked">
                                <StackPanel>
                                    <TextBlock Text="填满屏幕" FontFamily="{StaticResource AppFont}"
                                               Foreground="#27292D" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="铺满桌面，必要时裁切边缘"
                                               FontFamily="{StaticResource AppFont}" Foreground="#81858D"
                                               FontSize="10" Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="FitModeButton" Style="{StaticResource ModeOption}"
                                         GroupName="WallpaperMode" Tag="6" Checked="PositionMode_Checked">
                                <StackPanel>
                                    <TextBlock Text="完整显示" FontFamily="{StaticResource AppFont}"
                                               Foreground="#27292D" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="保持比例，完整展示图片"
                                               FontFamily="{StaticResource AppFont}" Foreground="#81858D"
                                               FontSize="10" Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="StretchModeButton" Style="{StaticResource ModeOption}"
                                         GroupName="WallpaperMode" Tag="2" Checked="PositionMode_Checked">
                                <StackPanel>
                                    <TextBlock Text="拉伸铺满" FontFamily="{StaticResource AppFont}"
                                               Foreground="#27292D" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="精确铺满，画面比例可能改变"
                                               FontFamily="{StaticResource AppFont}" Foreground="#81858D"
                                               FontSize="10" Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="应用后建议继续从本程序更换壁纸。"
                                       FontFamily="{StaticResource AppFont}" Foreground="#8B8F97"
                                       FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Button x:Name="ApplyWallpaperButton" IsEnabled="False"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="ApplyWallpaperButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="设为桌面壁纸" VerticalAlignment="Center" />
                                    <TextBlock Text="  ↗" FontSize="17" Margin="3,-1,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#9AA0A8"
                         VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="就绪"
                           Foreground="#7F838A" FontFamily="{StaticResource AppFont}"
                           FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="壁纸由 Windows 显示"
                           Foreground="#A0A3A9" FontFamily="{StaticResource AppFont}"
                           FontSize="10" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
