<Project Sdk="Microsoft.NET.Sdk">
  <!-- @author bomo；用途：构建新版壁纸工坊 Windows 桌面应用。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JBSWallpaperStudio</AssemblyName>
    <RootNamespace>JBSWallpaperStudio</RootNamespace>
    <Version>2.0.1</Version>
    <Authors>bomo</Authors>
    <Description>壁纸选择与预览工具</Description>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
  </ItemGroup>
</Project>
