<Project Sdk="Microsoft.NET.Sdk">
  <!-- @author bomo；用途：构建 WallpaperStudio Windows 桌面应用。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WallpaperStudio</AssemblyName>
    <RootNamespace>WallpaperStudio</RootNamespace>
    <Product>壁纸工坊</Product>
    <Version>2.1.0</Version>
    <Authors>bomo</Authors>
    <Description>壁纸选择与预览工具</Description>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
  </ItemGroup>
</Project>
